# ============================================
# AI STUDY PLANNER - ENVIRONMENT VARIABLES
# ============================================
# NEVER share this file or commit it to GitHub!

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/studyplanner?retryWrites=true&w=majority

# Google Gemini API Key (from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (make this a long random string - anything you want)
JWT_SECRET=my_super_secret_jwt_key_change_this_to_something_random_123456

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
